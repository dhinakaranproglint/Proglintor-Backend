# Copy to .env and adjust. Real environment variables override this file.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Host names / IPs the server answers on (the address agents and the admin app use).
DJANGO_ALLOWED_HOSTS=pulse.proglint.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://pulse.proglint.com
# Set to 1 when running behind an HTTPS reverse proxy (nginx, load balancer).
DJANGO_BEHIND_PROXY=0
TIME_ZONE=Asia/Kolkata

# --- PostgreSQL ---
POSTGRES_DB=proglint_pulse
POSTGRES_USER=proglint
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- E-mail for "Forgot password" codes (SMTP) ---
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=it@proglint.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Proglintor <it@proglint.com>

# Seconds since the last heartbeat before an agent counts as offline.
PULSE_ONLINE_SECONDS=90
