# Copy to .env and adjust. Real environment variables override this file.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Host names / IPs the server answers on (the address agents and the admin app use).
DJANGO_ALLOWED_HOSTS=pulse.proglint.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://pulse.proglint.com
# Set to 1 when running behind an HTTPS reverse proxy (nginx, load balancer).
DJANGO_BEHIND_PROXY=0
TIME_ZONE=Asia/Kolkata

# --- PostgreSQL ---
POSTGRES_DB=proglint_pulse
POSTGRES_USER=proglint
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- E-mail for "Forgot password" codes (SMTP) ---
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=it@proglint.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Proglintor <it@proglint.com>

# Seconds since the last heartbeat before an agent counts as offline.
PULSE_ONLINE_SECONDS=90

# Conversational install assistant (optional). Leave GEMINI_API_KEY empty to use the built-in replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
#GEMINI_TIMEOUT_SECONDS=12
#ASSIST_PER_10MIN=30

# --- Production hardening ---
# Set to "production" to refuse to start with DEBUG on, a placeholder secret or wildcard hosts.
#PULSE_ENV=production
# Where rate limits / counters live. They must be shared by all workers: "db" (default in production; `createcachetable` is
# automatic in the Docker image via createcachetable), "redis" (also set CACHE_REDIS_URL) or "locmem" (single process, dev only).
#CACHE_BACKEND=db
#CACHE_REDIS_URL=redis://localhost:6379/1
# Number of reverse proxies in front of the app, so the client IP for rate limiting is read correctly. 0 = trust none.
#PULSE_TRUSTED_PROXIES=1
# HTTPS hardening (on automatically behind a proxy when DEBUG is off): HSTS lifetime in seconds.
#SECURE_HSTS_SECONDS=2592000

# --- Install assistant privacy / cost switches ---
# Turn the AI chat or the web look-up of unknown software off entirely (catalogue installs keep working).
#ASSISTANT_CHAT_ENABLED=1
#ASSISTANT_WEB_LOOKUP_ENABLED=1
# New-software proposals one laptop may trigger per day.
#PROPOSALS_PER_DAY=5
